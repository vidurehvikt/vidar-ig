@startuml
title Vidar IG - Blodtrykksmaling
footer MalPatient, MalEncounterConsultation, MalObservationBloodPressure

class "MalPatient\n(Patient)" as Patient {
    identifier
    name
}

class "MalEncounterConsultation\n(Encounter)" as Encounter {
    status = finished
    class = ambulatory
    period.start
    period.end
}

class "MalObservationBloodPressure\n(Observation)" as Observation {
    category = vital-signs
    code = 85354-9
    effectiveDateTime
}

class "Systolisk komponent" as Systolic {
    code = 8480-6
    valueQuantity.value
    valueQuantity.unit = mmHg
}

class "Diastolisk komponent" as Diastolic {
    code = 8462-4
    valueQuantity.value
    valueQuantity.unit = mmHg
}

Patient <-- Observation : subject
Encounter <-- Observation : encounter
Patient <-- Encounter : subject

Observation *-- Systolic : component[systolisk]
Observation *-- Diastolic : component[diastolisk]

@enduml